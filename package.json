{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/inventoryMath.test.ts tests/unit/reports.test.ts",
    "emulators": "tests/rules/node_modules/.bin/firebase emulators:start --project demo-yaa-pos --export-on-exit=./staging/emulator-data",
    "dev:staging": "VITE_USE_EMULATORS=true PORT=3100 tsx server.ts",
    "seed:staging": "node scripts/staging/seed.mjs",
    "emulators:resume": "tests/rules/node_modules/.bin/firebase emulators:start --project demo-yaa-pos --import=./staging/emulator-data --export-on-exit=./staging/emulator-data"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
