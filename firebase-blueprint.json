{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information, role, branch assignment, and account status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastLogin": { "type": "string", "maxLength": 64 },
        "accountStatus": { "type": "string", "enum": ["Activo", "Suspendida", "Desactivada", "Pendiente"], "maxLength": 32 },
        "disabledTabs": { "type": "array" },
        "isOperator": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "branch": { "type": "string", "maxLength": 128 },
        "branches": { "type": "array" }
      },
      "required": ["id", "email", "name"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Independent commercial store branch definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 64 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "manager": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "inactive"], "maxLength": 32 },
        "isMain": { "type": "boolean" },
        "openingHours": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "code", "address", "phone", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Branch-isolated product inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "code": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 120 },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "expirationDate": { "type": "string", "maxLength": 64 },
        "unit": { "type": "string", "maxLength": 64 },
        "branch": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "brand": { "type": "string", "maxLength": 120 },
        "initialBatch": { "type": "string", "maxLength": 64 },
        "manageBatchAndExpiration": { "type": "boolean" },
        "unitsPerBlister": { "type": "number" },
        "pricePerBlister": { "type": "number" },
        "blistersPerBox": { "type": "number" },
        "unitsPerBox": { "type": "number" },
        "pricePerBox": { "type": "number" },
        "pricePerUnit": { "type": "number" }
      },
      "required": ["id", "name", "price", "cost", "stock", "minStock", "unit"]
    },
    "Client": {
      "title": "Client",
      "description": "Branch-scoped store client information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 300 },
        "nit": { "type": "string", "maxLength": 64 },
        "balanceCredit": { "type": "number" },
        "limitCredit": { "type": "number" },
        "branch": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "phone", "email", "balanceCredit", "limitCredit"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Branch-scoped inventory and stock provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "contact": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 300 },
        "branch": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "contact", "phone", "email"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A branch-scoped sale transaction receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "total": { "type": "number" },
        "profit": { "type": "number" },
        "received": { "type": "number" },
        "change": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "credit", "transfer"], "maxLength": 32 },
        "clientId": { "type": "string", "maxLength": 128 },
        "shiftId": { "type": "string", "maxLength": 128 },
        "branch": { "type": "string", "maxLength": 200 },
        "user": { "type": "string", "maxLength": 200 },
        "voucherType": { "type": "string", "enum": ["ticket", "boleta", "factura", "nota_venta"], "maxLength": 32 },
        "items": { "type": "array" }
      },
      "required": ["id", "date", "total", "profit", "received", "change", "paymentMethod", "shiftId"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "A branch-scoped restock purchase transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "total": { "type": "number" },
        "providerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["completed", "pending"], "maxLength": 32 },
        "paymentMethod": { "type": "string", "enum": ["cash", "credit"], "maxLength": 32 },
        "branch": { "type": "string", "maxLength": 200 },
        "user": { "type": "string", "maxLength": 200 },
        "items": { "type": "array" }
      },
      "required": ["id", "date", "total", "providerId", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Branch-scoped store operational expense log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 120 },
        "branch": { "type": "string", "maxLength": 200 },
        "user": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "date", "description", "amount", "category"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Branch-scoped daily cash register work shifts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "openedAt": { "type": "string", "maxLength": 64 },
        "closedAt": { "type": "string", "maxLength": 64 },
        "initialCash": { "type": "number" },
        "finalCash": { "type": "number" },
        "salesTotal": { "type": "number" },
        "expensesTotal": { "type": "number" },
        "state": { "type": "string", "enum": ["open", "closed"], "maxLength": 32 },
        "branch": { "type": "string", "maxLength": 200 },
        "user": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "openedAt", "initialCash", "salesTotal", "expensesTotal", "state"]
    },
    "UserFile": {
      "title": "UserFile",
      "description": "Metadata of user files uploaded to storage per branch",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "size": { "type": "number" },
        "path": { "type": "string", "maxLength": 1024 },
        "uploadedAt": { "type": "string", "maxLength": 64 },
        "branch": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "mimeType", "size", "path", "uploadedAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Configuration settings of the store and its branches",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 200 },
        "logo": { "type": "string", "maxLength": 500000 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 16 },
        "alertDaysBeforeExpiration": { "type": "number" },
        "businessType": { "type": "string", "enum": ["hardware", "pharmacy", "bookstore", "general"], "maxLength": 32 },
        "activeBranchId": { "type": "string", "maxLength": 128 },
        "branches": { "type": "array" }
      },
      "required": ["storeName", "currency", "alertDaysBeforeExpiration", "businessType"]
    },
    "Operator": {
      "title": "Operator",
      "description": "Store operator linked to the owner's account with branch and tab access privileges",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "role": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive"], "maxLength": 32 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "branch": { "type": "string", "maxLength": 200 },
        "branches": { "type": "array" },
        "disabledTabs": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "License": {
      "title": "License",
      "description": "Tenant subscription license and activation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 200 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "planType": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 64 },
        "expirationDate": { "type": "string", "maxLength": 64 },
        "daysRemaining": { "type": "number" },
        "status": { "type": "string", "enum": ["Activo", "Por Vencer", "Suspendida", "Expirada", "Desactivada", "Pendiente"], "maxLength": 32 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "clientName", "clientEmail", "planType", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile metadata and account status"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Branch-scoped store products"
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": "Client",
      "description": "Branch-scoped store clients"
    },
    "/users/{userId}/providers/{providerId}": {
      "schema": "Provider",
      "description": "Branch-scoped store providers"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Branch-scoped sales history"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Branch-scoped purchasing history"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Branch-scoped store expenses"
    },
    "/users/{userId}/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Branch-scoped cash register shifts"
    },
    "/users/{userId}/files/{fileId}": {
      "schema": "UserFile",
      "description": "Branch-scoped user files metadata"
    },
    "/users/{userId}/configs/{configId}": {
      "schema": "AppConfig",
      "description": "User-specific store and multi-branch configuration"
    },
    "/users/{userId}/operators/{operatorEmail}": {
      "schema": "Operator",
      "description": "Owner's isolated list of operators and cashiers with branch permissions"
    },
    "/operators/{operatorEmail}": {
      "schema": "Operator",
      "description": "Global operator mapping for session lookup and authentication"
    },
    "/licenses/{userId}": {
      "schema": "License",
      "description": "Tenant subscription licenses managed by system admin"
    }
  }
}
