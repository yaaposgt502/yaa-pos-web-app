rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // AUTHENTICATION & IDENTITY PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.@]+$');
    }

    // Check if the user is the global system admin (by UID, verified admin email, or /admins collection)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'uSEwpR9zZPWvekBQKdx1SMsrs7n1' ||
        (request.auth.token.get('email', null) != null &&
         request.auth.token.get('email_verified', false) == true &&
         request.auth.token.email.lower() == 'yaaposgt@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper to check if the current user is an active operator of the target owner
    function isOperatorOf(ownerId) {
      return isSignedIn() &&
             request.auth.token != null &&
             request.auth.token.email != null &&
             hasActiveOperator(ownerId, request.auth.token.email.lower());
    }

    // An operator record may be bound to a Firebase Auth UID (authUid). When it
    // is, only that exact account can act as the operator, so someone who
    // registers the same email address with another account gets no access.
    // Older records without authUid keep working by email, as before.
    function isBoundToCaller(opData) {
      return !('authUid' in opData) ||
             opData.authUid == null ||
             opData.authUid == '' ||
             opData.authUid == request.auth.uid;
    }

    function hasActiveOperator(ownerId, email) {
      let globalPath = /databases/$(database)/documents/operators/$(email);
      let tenantPath = /databases/$(database)/documents/users/$(ownerId)/operators/$(email);
      return (exists(globalPath) &&
              get(globalPath).data.ownerId == ownerId &&
              get(globalPath).data.status == 'active' &&
              isBoundToCaller(get(globalPath).data)) ||
             (exists(tenantPath) &&
              get(tenantPath).data.status == 'active' &&
              isBoundToCaller(get(tenantPath).data));
    }

    // Helper to check if a user is NOT suspended/deactivated in their user profile document
    function isAccountActive(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return !exists(userPath) || 
             !('accountStatus' in get(userPath).data) || 
             (get(userPath).data.accountStatus != 'Suspendida' && 
              get(userPath).data.accountStatus != 'Desactivada');
    }

    // Helper to check if a user's license is active (not suspended, deactivated, pending, or expired)
    function isLicenseActive(userId) {
      let licensePath = /databases/$(database)/documents/licenses/$(userId);
      return !exists(licensePath) || 
             !('status' in get(licensePath).data) || 
             (get(licensePath).data.status != 'Suspendida' && 
              get(licensePath).data.status != 'Desactivada' && 
              get(licensePath).data.status != 'Pendiente' && 
              get(licensePath).data.status != 'Expirada');
    }

    // Master Gate for Tenant Access (Owner, Active Operator, or Global Admin)
    function canReadTenant(userId) {
      return isSignedIn() && (
        isAdmin() ||
        ((request.auth.uid == userId || isOperatorOf(userId)) &&
         isAccountActive(userId) &&
         isLicenseActive(userId))
      );
    }

    function canWriteTenant(userId) {
      return isSignedIn() && (
        isAdmin() ||
        ((request.auth.uid == userId || isOperatorOf(userId)) &&
         isAccountActive(userId) &&
         isLicenseActive(userId))
      );
    }

    // Owner of the tenant (or global admin), with the account and license active.
    function isTenantOwnerOrAdmin(userId) {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         isAccountActive(userId) &&
         isLicenseActive(userId))
      );
    }

    // =========================================================================
    // ENTITY VALIDATION HELPERS
    // Kept deliberately tolerant: before this version a catch-all rule skipped
    // every validation, so documents written until now were never checked.
    // These checks only reject clearly malformed writes (wrong text types,
    // oversized text). Stricter validation (numeric fields, required fields)
    // must come with tests on the Firestore emulator.
    // =========================================================================
    function optStr(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function optList(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
             (data[field] is list && data[field].size() <= maxLen);
    }

    function isValidOptionalBranch(data) {
      return optStr(data, 'branch', 200);
    }

    function isValidUserProfile(data) {
      return optStr(data, 'name', 200) &&
             optStr(data, 'email', 256) &&
             optStr(data, 'role', 64) &&
             optStr(data, 'accountStatus', 32) &&
             isValidOptionalBranch(data);
    }

    function isValidTenantDoc(data) {
      return data is map && isValidOptionalBranch(data);
    }

    function isValidProduct(data) {
      return isValidTenantDoc(data) && optStr(data, 'name', 250);
    }

    function isValidNamedDoc(data) {
      return isValidTenantDoc(data) && optStr(data, 'name', 200);
    }

    function isValidSale(data) {
      return isValidTenantDoc(data) && optStr(data, 'date', 64);
    }

    function isValidPurchase(data) {
      return isValidTenantDoc(data) && optStr(data, 'date', 64);
    }

    function isValidExpense(data) {
      return isValidTenantDoc(data) && optStr(data, 'description', 2000);
    }

    function isValidShift(data) {
      return isValidTenantDoc(data) &&
             (!('state' in data) || data.state in ['open', 'closed']);
    }

    function isValidStockMovement(data) {
      return isValidTenantDoc(data) &&
             data.productId is string && data.productId.size() <= 128 &&
             data.refId is string && data.refId.size() <= 128 &&
             data.quantity is number &&
             data.type in ['venta', 'devolucion', 'compra', 'transferencia_salida', 'transferencia_entrada', 'ajuste'] &&
             optStr(data, 'productName', 250) &&
             optStr(data, 'reason', 200) &&
             optStr(data, 'date', 64);
    }

    function isValidUserFile(data) {
      return isValidTenantDoc(data) &&
             optStr(data, 'name', 256) &&
             optStr(data, 'path', 2048);
    }

    function isValidConfig(data) {
      return data is map &&
             optStr(data, 'storeName', 200) &&
             optStr(data, 'activeBranchId', 128) &&
             optList(data, 'branches', 100);
    }

    function isValidOperator(data, ownerId) {
      return data is map &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 200 &&
             data.status in ['active', 'inactive'] &&
             data.ownerId == ownerId &&
             (!('password' in data) || data.password == null) &&
             isValidOptionalBranch(data) &&
             optStr(data, 'authUid', 128) &&
             optList(data, 'branches', 100) &&
             optList(data, 'disabledTabs', 50);
    }

    function isValidQuotation(data) {
      return data.clientName is string && data.clientName.size() <= 200 &&
             (data.total is number) &&
             data.items is list && data.items.size() <= 500 &&
             data.status in ['borrador', 'vigente', 'vencida', 'aceptada', 'convertida'] &&
             isValidOptionalBranch(data);
    }

    function isValidConsignment(data) {
      return data.clientName is string && data.clientName.size() <= 200 &&
             data.items is list && data.items.size() <= 500 &&
             data.status in ['activa', 'liquidada_parcial', 'liquidada_total', 'devuelta_total'] &&
             isValidOptionalBranch(data);
    }

    // =========================================================================
    // CONNECTION TEST COLLECTION
    // =========================================================================
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // ADMINS COLLECTION
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // =========================================================================
    // USER PROFILE DOCUMENTS (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
                     isAdmin() ||
                     request.auth.uid == userId ||
                     isOperatorOf(userId)
                  );

      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
                       isAdmin() ||
                       // A new owner cannot grant itself a status, plan or license.
                       (request.auth.uid == userId &&
                        !('accountStatus' in incoming()) &&
                        !('plan' in incoming()) &&
                        !('licenseExpiresAt' in incoming()) &&
                        !('isOperator' in incoming()) &&
                        !('ownerId' in incoming()))
                    );

      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
                       isAdmin() ||
                       (request.auth.uid == userId &&
                        isAccountActive(userId) &&
                        isLicenseActive(userId) &&
                        // The owner cannot change its own status, plan, license or role.
                        (!('id' in incoming()) || incoming().id == userId) &&
                        ((!('accountStatus' in incoming()) && !('accountStatus' in existing())) || incoming().accountStatus == existing().accountStatus) &&
                        ((!('plan' in incoming()) && !('plan' in existing())) || incoming().plan == existing().plan) &&
                        ((!('licenseExpiresAt' in incoming()) && !('licenseExpiresAt' in existing())) || incoming().licenseExpiresAt == existing().licenseExpiresAt) &&
                        ((!('role' in incoming()) && !('role' in existing())) || incoming().role == existing().role))
                    );

      allow delete: if isAdmin();

      // =======================================================================
      // TENANT SUBCOLLECTIONS
      // Every subcollection is declared explicitly. There is NO catch-all:
      // any other path under /users/{userId} is denied by default.
      //
      // Branch restrictions for operators are NOT enforced here yet: branch
      // values are stored as free text (names, codes or ids) and compared
      // loosely by the app, so an exact check would block valid sales.
      // That comes with the branchId migration (Stage 4).
      // =======================================================================

      // Catalog data: owner and operators can create, edit and delete.
      match /products/{productId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(productId) && canWriteTenant(userId) && isValidProduct(incoming());
        allow delete: if isValidId(productId) && canWriteTenant(userId);
      }

      match /clients/{clientId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(clientId) && canWriteTenant(userId) && isValidNamedDoc(incoming());
        allow delete: if isValidId(clientId) && canWriteTenant(userId);
      }

      match /providers/{providerId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(providerId) && canWriteTenant(userId) && isValidNamedDoc(incoming());
        allow delete: if isValidId(providerId) && canWriteTenant(userId);
      }

      // Financial records: operators can create and update (e.g. returns,
      // paying a purchase, closing a shift) but only the owner or admin can
      // delete them.
      // Sales are registered once. Afterwards an operator can only mark the
      // sale as returned (once) or re-send the identical document (offline
      // retry); editing amounts or items is reserved to the owner or admin.
      match /sales/{saleId} {
        allow read: if canReadTenant(userId);
        allow create: if isValidId(saleId) && canWriteTenant(userId) && isValidSale(incoming());
        allow update: if isValidId(saleId) && isValidSale(incoming()) && (
                         isTenantOwnerOrAdmin(userId) ||
                         (canWriteTenant(userId) && (
                           incoming() == existing() ||
                           (!('returnSaleId' in existing()) &&
                            incoming().returnSaleId is string &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['returnSaleId', 'returnedAt'])))));
        allow delete: if isValidId(saleId) && isTenantOwnerOrAdmin(userId);
      }

      // Kardex: inventory movements are immutable. Re-sending the identical
      // document (offline retry) is accepted; only the owner can delete
      // (database reset).
      match /stockMovements/{movementId} {
        allow read: if canReadTenant(userId);
        allow create: if isValidId(movementId) && canWriteTenant(userId) && isValidStockMovement(incoming());
        allow update: if isValidId(movementId) && canWriteTenant(userId) && incoming() == existing();
        allow delete: if isValidId(movementId) && isTenantOwnerOrAdmin(userId);
      }

      match /purchases/{purchaseId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(purchaseId) && canWriteTenant(userId) && isValidPurchase(incoming());
        allow delete: if isValidId(purchaseId) && isTenantOwnerOrAdmin(userId);
      }

      match /shifts/{shiftId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(shiftId) && canWriteTenant(userId) && isValidShift(incoming());
        allow delete: if isValidId(shiftId) && isTenantOwnerOrAdmin(userId);
      }

      // Expenses can be deleted from the Cash Register screen by operators.
      match /expenses/{expenseId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(expenseId) && canWriteTenant(userId) && isValidExpense(incoming());
        allow delete: if isValidId(expenseId) && canWriteTenant(userId);
      }

      match /files/{fileId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(fileId) && canWriteTenant(userId) && isValidUserFile(incoming());
        allow delete: if isValidId(fileId) && canWriteTenant(userId);
      }

      match /quotations/{quotationId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(quotationId) && canWriteTenant(userId) && isValidTenantDoc(incoming()) && isValidQuotation(incoming());
        allow delete: if isValidId(quotationId) && canWriteTenant(userId);
      }

      match /consignments/{consignmentId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(consignmentId) && canWriteTenant(userId) && isValidTenantDoc(incoming()) && isValidConsignment(incoming());
        allow delete: if isValidId(consignmentId) && canWriteTenant(userId);
      }

      match /configs/{configId} {
        allow read: if canReadTenant(userId);
        allow create, update: if isValidId(configId) && canWriteTenant(userId) && isValidConfig(incoming());
        allow delete: if isValidId(configId) && isTenantOwnerOrAdmin(userId);
      }

      // Operators of this tenant: ONLY the owner (or admin) can create, edit
      // or delete them. Operators cannot raise their own permissions, remove
      // their branch restriction or invite other people.
      match /operators/{operatorEmail} {
        allow read: if canReadTenant(userId) || (
                       isSignedIn() &&
                       request.auth.token != null &&
                       request.auth.token.email != null &&
                       request.auth.token.email.lower() == operatorEmail.lower()
                    );
        allow create, update: if isTenantOwnerOrAdmin(userId) &&
                                 (isAdmin() || (isValidOperator(incoming(), userId) &&
                                  incoming().email.lower() == operatorEmail.lower()));
        allow delete: if isTenantOwnerOrAdmin(userId);
      }
    }

    // =========================================================================
    // LICENSES COLLECTION (/licenses/{userId})
    // =========================================================================
    match /licenses/{userId} {
      allow read: if isSignedIn() && (
                     request.auth.uid == userId ||
                     isOperatorOf(userId) ||
                     isAdmin()
                  );
      allow write: if isAdmin();
    }

    // =========================================================================
    // GLOBAL OPERATORS COLLECTION (/operators/{operatorEmail})
    // Used to find an operator's company at login. A record belongs to the
    // owner in its ownerId: nobody else can overwrite it or move it to
    // another company.
    // =========================================================================
    match /operators/{operatorEmail} {
      allow read: if isSignedIn() && (
                     (request.auth.token != null &&
                      request.auth.token.email != null &&
                      request.auth.token.email.lower() == operatorEmail.lower()) ||
                     (resource != null && resource.data.ownerId == request.auth.uid) ||
                     isAdmin()
                  );
      allow create: if isSignedIn() && (
                       isAdmin() ||
                       (isTenantOwnerOrAdmin(request.auth.uid) &&
                        isValidOperator(incoming(), request.auth.uid) &&
                        incoming().email.lower() == operatorEmail.lower())
                    );
      allow update: if isSignedIn() && (
                       isAdmin() ||
                       (existing().ownerId == request.auth.uid &&
                        isTenantOwnerOrAdmin(request.auth.uid) &&
                        isValidOperator(incoming(), request.auth.uid) &&
                        incoming().email.lower() == operatorEmail.lower())
                    );
      allow delete: if isSignedIn() && (
                       isAdmin() ||
                       (resource != null && resource.data.ownerId == request.auth.uid)
                    );
    }
  }
}
